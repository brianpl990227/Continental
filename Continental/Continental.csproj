<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Android and Windows are the shipping targets. Apple targets need a Mac to
             build at all, so they are opt-in: build with -p:IncludeApple=true on macOS. -->
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="'$(IncludeApple)' == 'true'">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>Continental</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Continental</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.continental</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- ====================================================================
         Universal APK.

         CoreCLR is the default Android runtime in .NET 10 and ships no 32-bit ARM
         runtime pack, so armeabi-v7a is silently dropped from a multi-ABI build and
         phones running a 32-bit Android image cannot install the app at all. Mono
         still carries android-arm, so a universal APK has to fall back to it.

         UseMonoRuntime is scoped to this project and to the android target on purpose:
         as a global property it flows into the referenced net10.0 libraries, which then
         demand a Mono runtime pack for the host platform that does not exist (NU1102).

         RuntimeIdentifiers is the input the Android SDK actually reads; AndroidSupportedAbis
         is derived from it. Passing the ABI list alone got armeabi-v7a dropped without a
         word. It is set here rather than on the command line because as a global property
         it reaches the referenced net10.0 libraries, which have no android runtime pack.

         Mono is a dead end - .NET 11 removes it - so this is only for the universal
         build, and -AllAbis is what turns it on.
         ==================================================================== -->
    <PropertyGroup Condition="'$(UniversalApk)' == 'true' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <UseMonoRuntime>true</UseMonoRuntime>
        <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
        <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0A1A17" />

        <!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A1A17" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Continental.Core\Continental.Core.csproj" />
        <ProjectReference Include="..\Continental.Shared\Continental.Shared.csproj" />
        <ProjectReference Include="..\Continental.Server\Continental.Server.csproj" />
    </ItemGroup>

    <!-- ====================================================================
         Bundle the browser client.

         The host device serves Continental.WebClient to guests who do not have
         the app installed, so its published output has to travel inside this one
         as a zip (app package assets are not real files on Android, so the app
         unpacks it on first run).

         Incremental: only republishes when the shared UI or the client changes.
         Pass -p:BuildWebClient=false to skip it during quick inner-loop builds.
         ==================================================================== -->
    <PropertyGroup>
        <WebClientProject>$(MSBuildProjectDirectory)\..\Continental.WebClient\Continental.WebClient.csproj</WebClientProject>
        <!-- Per target framework: a multi-targeting build compiles android and windows in
             parallel, and a shared staging folder had both passes publishing the web client
             into the same directory at once. One of them lost the race, produced no zip, and
             the whole build then died on a missing MauiAsset. -->
        <WebClientStaging>$(MSBuildProjectDirectory)\obj\webclient-$(TargetFramework)</WebClientStaging>
        <WebClientZip>$(MSBuildProjectDirectory)\Resources\Raw\webclient.zip</WebClientZip>
    </PropertyGroup>

    <ItemGroup>
        <WebClientSource Include="$(MSBuildProjectDirectory)\..\Continental.WebClient\**\*.cs;&#xA;                                  $(MSBuildProjectDirectory)\..\Continental.WebClient\**\*.razor;&#xA;                                  $(MSBuildProjectDirectory)\..\Continental.WebClient\**\*.html;&#xA;                                  $(MSBuildProjectDirectory)\..\Continental.WebClient\*.csproj;&#xA;                                  $(MSBuildProjectDirectory)\..\Continental.Shared\**\*.cs;&#xA;                                  $(MSBuildProjectDirectory)\..\Continental.Shared\**\*.razor;&#xA;                                  $(MSBuildProjectDirectory)\..\Continental.Shared\**\*.css;&#xA;                                  $(MSBuildProjectDirectory)\..\Continental.Core\**\*.cs" Exclude="$(MSBuildProjectDirectory)/../**/obj/**;$(MSBuildProjectDirectory)/../**/bin/**" />
    </ItemGroup>

    <Target Name="BundleWebClient" BeforeTargets="BeforeBuild" Condition="'$(BuildWebClient)' != 'false'" Inputs="@(WebClientSource)" Outputs="$(WebClientZip)">

        <Message Importance="high" Text="Publicando el cliente web para empaquetarlo..." />

        <RemoveDir Directories="$(WebClientStaging)" ContinueOnError="true" />

        <Exec Command="dotnet publish &quot;$(WebClientProject)&quot; -c Release -o &quot;$(WebClientStaging)&quot; --nologo -v quiet" ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="WebClientExit" />
        </Exec>

        <Warning Condition="'$(WebClientExit)' != '0'" Text="No se pudo publicar el cliente web; la sala servirá una pagina de aviso en su lugar." />

        <MakeDir Directories="$(MSBuildProjectDirectory)\Resources\Raw" />

        <Delete Files="$(WebClientZip)" ContinueOnError="true" />

        <ZipDirectory Condition="'$(WebClientExit)' == '0' AND Exists('$(WebClientStaging)\wwwroot')" SourceDirectory="$(WebClientStaging)\wwwroot" DestinationFile="$(WebClientZip)" Overwrite="true" />

        <!-- The asset has to exist: MauiAsset copies it unconditionally and MSB3030 kills
             the build if it is missing. When the web client could not be produced, ship a
             zip carrying only a note. The app already serves that page, and a browser
             client that failed to build should never block an APK. -->
        <MakeDir Condition="!Exists('$(WebClientZip)')" Directories="$(WebClientStaging)\fallback" />

        <WriteLinesToFile Condition="!Exists('$(WebClientZip)')" File="$(WebClientStaging)\fallback\index.html" Overwrite="true" Lines="&lt;!doctype html&gt;&lt;meta charset=utf-8&gt;&lt;title&gt;Continental&lt;/title&gt;&lt;p&gt;El cliente para navegador no se incluyo en esta compilacion. Unete desde la app instalada." />

        <ZipDirectory Condition="!Exists('$(WebClientZip)')" SourceDirectory="$(WebClientStaging)\fallback" DestinationFile="$(WebClientZip)" Overwrite="true" />

        <Warning Condition="'$(WebClientExit)' != '0'" Text="El cliente para navegador no se empaqueto: la sala servira solo un aviso en esa direccion." />
    </Target>

</Project>
