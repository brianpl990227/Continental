    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Audio.InitAsync();

            Audio.Unlock();

            await Flights.InitAsync();
            await Party.InitAsync();
            await Progress.LoadAsync();

            if (View is { } current)
                Progress.Observe(current);

            await SendBadgeAsync();

            StateHasChanged();
            return;
        }

        if (Pending.Count > 0)
        {
            var batch = Pending.ToList();
            Pending.Clear();

            Flights.Play(batch);
        }

        if (PendingSeats.Count > 0)
        {
            var batch = PendingSeats.ToList();
            PendingSeats.Clear();

            Flights.Play(batch);
        }
    }

    private void OnChanged() => InvokeAsync(() =>
    {
        if (View is { } view)
        {
            if (view.Phase == GamePhase.Lobby)
            {
                SawLobby = true;
                LastRound = -1;
            }

            if (view.RoundIndex != LastRound && view.Phase is GamePhase.Draw or GamePhase.StealWindow or GamePhase.Action)
            {
                var opening = SawLobby && view.RoundIndex == 0 && LastRound < 0;

                LastRound = view.RoundIndex;
                Swapping = null;
                SawLobby = false;

                if (opening)
                {
                    ShowIntro = true;
                    Dealing = false;
                    _ = EndIntroLaterAsync();
                }
                else
                {
                    Dealing = true;
                    _ = ClearDealingSoon();
                    _ = ShowRoundCardAsync(view.RoundIndex);

                    if (view.RoundIndex == 0)
                        _ = Send(new ClientMessage { Type = MessageType.IntroDone });
                }
            }

            if (view.Hand.Count != LastHandCount)
            {
                LastHandCount = view.Hand.Count;
                Selected.RemoveWhere(id => view.Hand.All(c => c.Id != id));
                PickOrder.RemoveAll(id => !Selected.Contains(id));
                RefreshSelection();
            }

            if (Swapping is { } swap && (!view.YourTurn || view.Hand.All(c => c.Id != swap.CardId)))
                Swapping = null;

            Sonify(view);
            QueueFlights(view);
            TrackChat(view);
            Progress.Observe(view);

            if (SentBadgeVersion != Progress.BadgeVersion)
                _ = SendBadgeAsync();
        }

        StateHasChanged();
    });

    private void TrackChat(PlayerView view)
    {
        var now = DateTime.UtcNow;
        var heard = LastHeardSeq;
        var fresh = false;

        foreach (var line in view.Chat)
        {
            if (BubbleShownAt.ContainsKey(line.Seq))
                continue;

            if (line.Seq <= heard)
            {
                BubbleShownAt[line.Seq] = DateTime.MinValue;
                continue;
            }

            BubbleShownAt[line.Seq] = now;
            LastHeardSeq = line.Seq;
            fresh = true;

            if (line.PlayerId != view.YouId)
                Audio.Play(Sfx.Chat);
        }

        if (ShowChat)
            LastSeenSeq = view.Chat.Count > 0 ? Math.Max(LastSeenSeq, view.Chat[^1].Seq) : LastSeenSeq;

        if (BubbleShownAt.Count > 120)
        {
            foreach (var stale in BubbleShownAt.Where(kv => now - kv.Value > BubbleLife).Select(kv => kv.Key).ToList())
                BubbleShownAt.Remove(stale);
        }

        if (fresh)
            _ = ExpireBubblesSoon();
    }

    private async Task ExpireBubblesSoon()
    {
        await Task.Delay(BubbleLife + TimeSpan.FromMilliseconds(250));
        await InvokeAsync(StateHasChanged);
    }

    private void QueueFlights(PlayerView view)
    {
        QueueOpponentDraws(view);

        var handIds = view.Hand.Select(c => c.Id).ToHashSet();

        if (PrevHandIds is not null && !Dealing)
        {
            var gained = handIds.Except(PrevHandIds).ToList();

            if (gained.Count is > 0 and <= 3)
            {
                var fromDiscard = PrevDiscardCount >= 0 && view.DiscardCount < PrevDiscardCount;

                for (var i = 0; i < gained.Count; i++)
                {
                    var source = i == 0 && fromDiscard ? CardFlight.Discard : CardFlight.Stock;

                    Pending.Add(new Flight(
                        CardFlight.CardAt(gained[i]),
                        source,
                        FromRect: null,
                        Flip: source == CardFlight.Stock));
                }
            }
        }

        if (PrevDiscardCount >= 0 && view.DiscardCount > PrevDiscardCount && view.DiscardTop is not null)
        {
            if (view.DiscardOwnerId == view.YouId && DiscardOrigin is not null)
                Pending.Add(new Flight(CardFlight.DiscardCard, null, DiscardOrigin, Flip: false));
            else if (view.DiscardOwnerId is { } owner)
                Pending.Add(new Flight(CardFlight.DiscardCard, CardFlight.Seat(owner), null, Flip: false));

            DiscardOrigin = null;
        }

        PrevDiscardCount = view.DiscardCount;

        QueueMeldFlights(view);

        PrevHandIds = handIds;
        PrevMeldCards = view.Table.SelectMany(m => m.Cards.Select(c => (c.Id, m.Id)))
                            .ToDictionary(x => x.Item1, x => x.Item2);
        PrevMeldSizes = view.Table.ToDictionary(m => m.Id, m => m.Cards.Count);
    }

    private void QueueOpponentDraws(PlayerView view)
    {
        var previous = PrevCardCounts;
        var stockBefore = PrevStockCount;
        var topBefore = PrevDiscardTop;
        var sameRound = PrevRoundSeen == view.RoundIndex;

        PrevCardCounts = view.Players.ToDictionary(p => p.Id, p => p.CardCount);
        PrevStockCount = view.StockCount;
        PrevDiscardTop = view.DiscardTop;
        PrevRoundSeen = view.RoundIndex;

        if (previous is null || !sameRound || Dealing || ShowIntro || view.Phase is GamePhase.Lobby or GamePhase.RoundEnd or GamePhase.GameOver)
            return;

        var fromDiscard = topBefore is not null && PrevDiscardCount >= 0 && view.DiscardCount < PrevDiscardCount;
        var fromStock = stockBefore >= 0 && view.StockCount < stockBefore;

        if (!fromDiscard && !fromStock)
            return;

        var gains = view.Players
                        .Select(p => (Player: p, Gained: previous.TryGetValue(p.Id, out var before) ? p.CardCount - before : 0))
                        .Where(x => x.Gained > 0)
                        .ToList();

        if (gains.Count == 0)
            return;

        var takerId = fromDiscard ? gains.MaxBy(x => x.Gained).Player.Id : null;
        var delay = 0;

        foreach (var (player, gained) in gains)
        {
            if (player.Id == view.YouId)
                continue;

            var seat = CardFlight.Seat(player.Id);
            var fromPile = gained;

            if (player.Id == takerId)
            {
                TakenCard = topBefore;
                PendingSeats.Add(new SeatFlight(CardFlight.Discard, CardFlight.TakenCard, seat, FaceUp: true, delay));
                ShowTake(player, topBefore!.Value, gained - 1);
                Audio.Play(Sfx.OpponentTake);
                fromPile--;
                delay += 420;
            }
            else
            {
                Audio.Play(Sfx.OpponentDraw);
            }

            for (var i = 0; i < Math.Min(fromPile, 3); i++)
            {
                PendingSeats.Add(new SeatFlight(CardFlight.Stock, CardFlight.StockCard, seat, FaceUp: false, delay));
                delay += 140;
            }
        }
    }

