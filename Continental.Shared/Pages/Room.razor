    private void QueueMeldFlights(PlayerView view)
    {
        if (PrevMeldCards is null || Dealing)
        {
            LayOrigins.Clear();
            return;
        }

        var actor = view.Players.FirstOrDefault(p => p.IsCurrent);
        var swapped = false;
        var arrivals = 0;

        foreach (var meld in view.Table)
        {
            var isNew = PrevMeldSizes is null || !PrevMeldSizes.ContainsKey(meld.Id);
            var gained = 0;

            foreach (var card in meld.Cards)
            {
                if (PrevMeldCards.TryGetValue(card.Id, out var previous) && previous == meld.Id)
                    continue;

                var delay = Math.Min(gained, 8) * 70 + Math.Min(arrivals, 3) * 40;
                var target = CardFlight.CardAt(card.Id);

                if (LayOrigins.TryGetValue(card.Id, out var rect))
                    Pending.Add(new Flight(target, null, rect, Flip: false, delay));
                else if (previous is not null)
                    Pending.Add(new Flight(target, CardFlight.MeldAt(previous), null, Flip: false, delay));
                else if (PrevHandIds is not null && PrevHandIds.Contains(card.Id))
                    Pending.Add(new Flight(target, CardFlight.Hand, null, Flip: false, delay));
                else
                {
                    var from = actor is not null && actor.Id != view.YouId ? actor.Id : meld.OwnerId;
                    Pending.Add(new Flight(target, CardFlight.Seat(from), null, Flip: true, delay));
                }

                gained++;
            }

            if (gained > 0)
            {
                arrivals++;

                if (!isNew && PrevMeldSizes is not null && PrevMeldSizes[meld.Id] == meld.Cards.Count)
                    swapped = true;
            }
        }

        if (swapped)
            Audio.Play(Sfx.Swap);

        LayOrigins.Clear();
    }

    private void Sonify(PlayerView view)
    {
        if (LastPhase == GamePhase.Lobby && view.Phase != GamePhase.Lobby)
            Audio.Play(Sfx.Shuffle);
        else if (view.RoundIndex != LastSonifiedRound && view.Phase == GamePhase.Draw)
            Audio.Play(Sfx.Shuffle);

        LastSonifiedRound = view.RoundIndex;

        var myTurn = view.YourTurn && view.Phase is GamePhase.Draw or GamePhase.Action;

        if (myTurn && !WasMyTurn)
            Audio.Play(Sfx.Turn);

        WasMyTurn = myTurn;

        if (LastDiscardCount >= 0 && view.DiscardCount > LastDiscardCount)
            Audio.Play(Sfx.Place);

        LastDiscardCount = view.DiscardCount;

        if (LastTableCount >= 0 && view.Table.Count > LastTableCount)
        {
            var mineIsNewest = view.Table.Count > 0 && view.Table[^1].OwnerId == view.YouId;
            Audio.Play(mineIsNewest ? Sfx.LayDown : Sfx.OpponentLayDown);
        }

        LastTableCount = view.Table.Count;

        if (view.Steal is { YouCanClaim: true } steal)
        {
            if (LastPhase != GamePhase.StealWindow)
                Audio.Play(Sfx.Steal);
            else if (steal.SecondsLeft != LastStealSecond && steal.SecondsLeft > 0)
                Audio.Play(Sfx.Tick);

            LastStealSecond = steal.SecondsLeft;
        }
        else
        {
            LastStealSecond = -1;
        }

        if (view.Phase != LastPhase)
        {
            if (view.Phase == GamePhase.RoundEnd)
            {
                ShowScores = false;
                ShowChat = false;
                Celebrate(view, isGameOver: false);
            }
            else if (view.Phase == GamePhase.GameOver)
            {
                ShowScores = false;
                ShowChat = false;
                ShowFinale = true;
                _ = EndFinaleLaterAsync();
            }
        }

        LastPhase = view.Phase;

        if (Error is not null && Error != LastErrorHeard)
            Audio.Play(Sfx.Error);

        LastErrorHeard = Error;
    }

