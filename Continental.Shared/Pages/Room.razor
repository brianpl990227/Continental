    private (bool Droppable, bool Swappable, bool Target) MeldState(MeldView meld)
    {
        if (View is null)
            return (false, false, false);

        if (Swapping is not null)
            return (false, false, SwapFitsFor(meld.Id).Count > 0);

        if (!CanExtend)
            return (false, false, false);

        var cardId = Selected.First();
        var card = View.Hand.FirstOrDefault(c => c.Id == cardId);

        if (card.Id != cardId)
            return (false, false, false);

        var model = ToMeld(meld);
        var options = View.Options;

        var droppable = (options.CanExtendOpponentMelds || meld.OwnerId == View.YouId)
                        && MeldValidator.ExtendPositions(model, card, options).Count > 0;

        return (droppable, JokerIndexFor(model, card, options) >= 0, false);
    }

    private Task MeldClick(string meldId)
        => Swapping is null ? Extend(meldId) : PlaceJokerAt(meldId);

    private async Task Extend(string meldId)
    {
        if (!CanExtend || View is null)
            return;

        var cardId = Selected.First();
        var card = View.Hand.FirstOrDefault(c => c.Id == cardId);
        var view = View.Table.FirstOrDefault(m => m.Id == meldId);

        if (view is null || card.Id != cardId)
            return;

        var meld = ToMeld(view);
        var options = View.Options;
        var choices = new List<Choice>();

        var ends = (options.CanExtendOpponentMelds || meld.OwnerId == View.YouId)
            ? MeldValidator.ExtendPositions(meld, card, options)
            : [];

        if (ends.Count > 1)
        {
            foreach (var (slot, side) in new[] { (ends[0], "izquierda"), (ends[^1], "derecha") })
            {
                var trial = new List<Card>(meld.Cards);
                trial.Insert(slot, card);

                var label = card.IsJoker
                    ? $"A la {side}, haciendo de {JokerName(trial, slot, options)}"
                    : $"Poner {card.Label} a la {side}";

                choices.Add(new Choice(label, false, () => SendExtend(meldId, cardId, slot)));
            }
        }
        else if (ends.Count == 1)
        {
            var slot = ends[0];
            choices.Add(new Choice($"Poner {card.Label}", false, () => SendExtend(meldId, cardId, slot)));
        }

        var jokerIndex = JokerIndexFor(meld, card, options);

        if (jokerIndex >= 0)
            choices.Add(new Choice($"Canjear el comodín por {card.Label}", true, () => BeginSwap(meld, cardId, card, jokerIndex)));

        switch (choices.Count)
        {
            case 0:
                if (!options.CanExtendOpponentMelds && meld.OwnerId != View.YouId)
                    Hint = "En esta variante solo puedes ampliar tus propios juegos.";
                else
                    Hint = $"{card.Label} no encaja en ese juego.";

                Audio.Play(Sfx.Error);
                return;

            case 1:
                await Resolve(choices[0]);
                return;

            default:
                Choosing = new PendingChoice("¿Qué hago?", choices);
                return;
        }
    }

    private int JokerIndexFor(Meld meld, Card card, GameOptions options)
    {
        if (options.JokerSwapMode == JokerSwap.Off || meld.Kind != MeldKind.Escalera || card.IsJoker)
            return -1;

        if (options.JokerSwapMode == JokerSwap.OwnerOnly && meld.OwnerId != View?.YouId)
            return -1;

        for (var i = 0; i < meld.Size; i++)
        {
            if (MeldValidator.JokerStandsFor(meld, i, options) is { } stands
                && stands.Rank == card.Rank && stands.Suit == card.Suit)
            {
                return i;
            }
        }

        return -1;
    }

    private async Task BeginSwap(Meld source, int cardId, Card replacement, int jokerIndex)
    {
        if (View is null)
            return;

        Swapping = new PendingSwap(source.Id, cardId, replacement, jokerIndex, source.Cards[jokerIndex]);

        var destinations = View.Table
            .Select(m => (m.Id, Fits: SwapFitsFor(m.Id)))
            .Where(d => d.Fits.Count > 0)
            .ToList();

        var slots = destinations.Sum(d => d.Fits.Count);

        if (slots == 0)
        {
            Swapping = null;
            Hint = "El comodín no cabe en ningún juego sin romperlo.";
            Audio.Play(Sfx.Error);
            return;
        }

        if (slots == 1)
        {
            var only = destinations[0];
            await SendSwap(source.Id, cardId, only.Id == source.Id ? null : only.Id, only.Fits[0]);
            return;
        }

        Hint = null;
        Audio.Play(Sfx.Select);
    }

    private void CancelSwap()
    {
        Swapping = null;
        Audio.Play(Sfx.Tap);
    }

    private IReadOnlyList<int> SwapFitsFor(string meldId)
    {
        if (View is null || Swapping is not { } swap)
            return [];

        var targetView = View.Table.FirstOrDefault(m => m.Id == meldId);
        var sourceView = View.Table.FirstOrDefault(m => m.Id == swap.SourceMeldId);

        if (targetView is null || sourceView is null)
            return [];

        var options = View.Options;

        if (targetView.OwnerId != View.YouId && !options.CanExtendOpponentMelds)
            return [];

        var probe = ToMeld(targetView);

        if (targetView.Id == sourceView.Id)
        {
            if (swap.JokerIndex >= probe.Cards.Count || !probe.Cards[swap.JokerIndex].IsJoker)
                return [];

            probe.Cards[swap.JokerIndex] = swap.Replacement;
        }

        return MeldValidator.ExtendPositions(probe, swap.Joker, options);
    }

    private async Task PlaceJokerAt(string meldId)
    {
        if (View is null || Swapping is not { } swap)
            return;

        var fits = SwapFitsFor(meldId);

        if (fits.Count == 0)
        {
            Hint = "Ahí el comodín no cabe.";
            Audio.Play(Sfx.Error);
            return;
        }

        var targetId = meldId == swap.SourceMeldId ? null : meldId;

        if (fits.Count == 1)
        {
            await SendSwap(swap.SourceMeldId, swap.CardId, targetId, fits[0]);
            return;
        }

        var targetView = View.Table.First(m => m.Id == meldId);
        var probe = ToMeld(targetView);

        if (targetId is null)
            probe.Cards[swap.JokerIndex] = swap.Replacement;

        var choices = new List<Choice>();

        foreach (var (slot, side) in new[] { (fits[0], "izquierda"), (fits[^1], "derecha") })
        {
            var trial = new List<Card>(probe.Cards);
            trial.Insert(slot, swap.Joker);

            choices.Add(new Choice($"A la {side}, haciendo de {JokerName(trial, slot, View.Options)}", false,
                                   () => SendSwap(swap.SourceMeldId, swap.CardId, targetId, slot)));
        }

        Choosing = new PendingChoice("¿Por qué lado va el comodín?", choices);
    }

    private async Task SendExtend(string meldId, int cardId, int position)
    {
        await RememberOrigins([cardId]);

        await Send(new ClientMessage
        {
            Type = MessageType.Extend,
            MeldId = meldId,
            CardId = cardId,
            Position = position
        });

        ClearSelection();
    }

    private async Task SendSwap(string meldId, int cardId, string? targetMeldId, int position)
    {
        Swapping = null;

        await RememberOrigins([cardId]);

        await Send(new ClientMessage
        {
            Type = MessageType.SwapJoker,
            MeldId = meldId,
            CardId = cardId,
            TargetMeldId = targetMeldId,
            Position = position
        });

        ClearSelection();
    }

    private async Task Discard()
    {
        if (!CanDiscard)
            return;

        var cardId = Selected.First();

        DiscardOrigin = await Flights.CaptureAsync(CardFlight.CardAt(cardId));

        await Send(new ClientMessage { Type = MessageType.Discard, CardId = cardId });

        ClearSelection();
    }

    private async Task Leave()
    {
        await App.LeaveAsync();
        await Host.StopAsync();

        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        if (Client is not null)
            Client.Changed -= OnChanged;
    }
}
