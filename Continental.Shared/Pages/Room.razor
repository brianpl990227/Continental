@page "/room"
@implements IDisposable
@inject AppState App
@inject IGameHost Host
@inject NavigationManager Nav
@inject GameAudio Audio
@inject CardFlight Flights
@inject Confetti Party
@inject ProgressService Progress

@if (View is null)
{
    <div class="home">
        <div class="empty" style="margin-top:36vh">
            @if (Client is null)
            {
                <span>No hay ninguna sala abierta.</span>
            }
            else if (Link == ConnectionState.Reconnecting)
            {
                <span class="spinner"></span>
                <span>Reconectando con el anfitrión@(Attempt > 1 ? $" (intento {Attempt})" : "")…</span>
            }
            else if (Error is not null)
            {
                <span style="color:var(--ember);font-weight:650">@Error</span>
            }
            else
            {
                <span class="spinner"></span>
                <span>Conectando con la mesa…</span>
                <span style="font-size:11px">Si tarda, comprueba que el anfitrión sigue en la sala.</span>
            }
        </div>
        <button class="btn btn--primary" style="width:100%;margin-top:16px" @onclick="Leave">Volver al inicio</button>
    </div>
}
else if (View.Phase == GamePhase.Lobby)
{
    <div class="home">
        <div class="sheet__head" style="padding-left:0;padding-right:0">
            <h1 class="sheet__title">@View.RoomName</h1>
            <button class="btn btn--ghost btn--icon" @onclick="Leave" aria-label="Salir">✕</button>
        </div>

        @if (Host.JoinUrl is { } url)
        {
            <div class="join-info">
                <div class="field__label" style="margin:0">Para unirse desde un navegador</div>
                <div class="join-info__url">@url</div>
                @if (Host.WebClientReady)
                {
                    <div class="join-info__hint">
                        Quien no tenga la app puede abrir esa dirección en el móvil o el portátil,
                        siempre que esté en el mismo WiFi. Si no carga, revisa que el cortafuegos
                        deje entrar conexiones a este equipo.
                    </div>
                }
                else
                {
                    <div class="join-info__hint" style="color:var(--ember)">
                        El cliente para navegador no se pudo preparar en esta compilación, así que
                        esa dirección mostrará solo un aviso. Los demás todavía pueden unirse
                        desde la app.
                    </div>
                }
            </div>
        }

        <div class="section-title">Jugadores (@View.Players.Count/6)</div>

        <div class="lobby__players">
            @foreach (var player in View.Players.OrderBy(p => p.Seat))
            {
                <div class="lobby__player">
                    <span class="seat__avatar @(player.Badge?.Avatar is null ? "" : "seat__avatar--emoji")">@AvatarOf(player)</span>
                    <span class="lobby__who">
                        <span>@player.Name</span>
                        @if (player.Badge?.Title is { } title)
                        {
                            <span class="lobby__title">@title</span>
                        }
                    </span>
                    @if (player.Badge is { } badge)
                    {
                        <span class="lvl lvl--sm rank--@Leveling.RankFor(badge.Level).Tier" title="Nivel @badge.Level"><span class="lvl__n">@badge.Level</span></span>
                    }
                    @if (player.IsHost)
                    {
                        <span class="lobby__badge">Anfitrión</span>
                    }
                    @if (player.IsBot)
                    {
                        <span class="lobby__badge">Bot</span>
                    }
                    @if (View.YouAreHost && !player.IsHost)
                    {
                        <button class="btn btn--ghost btn--icon" style="min-height:32px;width:32px"
                                @onclick="@(() => Send(new ClientMessage { Type = MessageType.Kick, PlayerId = player.Id }))"
                                aria-label="Quitar a @player.Name">✕</button>
                    }
                </div>
            }

            @for (var i = View.Players.Count; i < 4; i++)
            {
                <div class="lobby__player lobby__player--empty">Sitio libre</div>
            }
        </div>

        @if (View.YouAreHost)
        {
            <div class="section-title">Bots</div>

            <button class="btn" style="width:100%" disabled="@(View.Players.Count >= 6)" @onclick="AddBot">
                Añadir un bot
            </button>

            <div class="section-title">Reglas</div>

            <div style="display:flex;gap:8px;margin-bottom:10px">
                <button class="btn btn--grow @(View.Options.Preset == RulePreset.LatinAmerica ? "btn--primary" : "")"
                        @onclick="@(() => SetPreset(RulePreset.LatinAmerica))">
                    🌎 Latinoamérica
                </button>
                <button class="btn btn--grow @(View.Options.Preset == RulePreset.Spain ? "btn--primary" : "")"
                        @onclick="@(() => SetPreset(RulePreset.Spain))">
                    🇪🇸 España
                </button>
            </div>
        }

        <button class="btn" style="width:100%" @onclick="@(() => ShowRules = true)">
            Ver las reglas de esta sala
        </button>

        @if (View.YouAreHost)
        {
            <button class="btn btn--primary" style="width:100%;margin-top:10px"
                    disabled="@(View.Players.Count < 2)"
                    @onclick="@(() => Send(new ClientMessage { Type = MessageType.Start }))">
                @(View.Players.Count < 2 ? "Faltan jugadores" : "Empezar la partida")
            </button>
        }
        else
        {
            <div class="empty" style="margin-top:14px">
                <span class="spinner"></span>
                <span>Esperando a que el anfitrión empiece…</span>
            </div>
        }
    </div>
}
else
{
    <div class="table">
        <RoundLadder RoundIndex="View.RoundIndex" Options="View.Options"
                     CanPause="@(View.CanPause && !View.Paused && !ShowIntro)" OnPause="PauseGame" />

        @if (ShowIntro)
        {
            <GameIntro Players="View.Players" YouId="@View.YouId" Contract="@View.ContractText" OnDone="EndIntro" />
        }
        else if (RoundCard is { } card)
        {
            <div class="roundcard" @key="card" role="status">
                <span class="roundcard__n">Ronda @(card + 1) de @View.TotalRounds</span>
                <span class="roundcard__code">@RoundContract.Standard[card].Code</span>
                <span class="roundcard__text">@RoundContract.Standard[card].Describe()</span>
            </div>
        }

        <div class="seats">
            @foreach (var player in View.Players.Where(p => p.Id != View.YouId).OrderBy(p => p.Seat))
            {
                <div class="seat seat--s@(Accent(player.Seat)) @(player.IsCurrent ? "seat--current" : "") @(player.IsBot ? "seat--bot" : "") @(player.IsConnected ? "" : "seat--offline") @(LastTake?.PlayerId == player.Id ? "seat--took" : "")"
                     data-seat="@player.Id">
                    <span class="seat__avatar @(player.Badge?.Avatar is null ? "" : "seat__avatar--emoji")">
                        @AvatarOf(player)
                        @if (player.Badge is { } badge)
                        {
                            <span class="seat__lvl rank--@Leveling.RankFor(badge.Level).Tier" title="@(badge.Title is null ? $"Nivel {badge.Level}" : $"Nivel {badge.Level} · {badge.Title}")">@badge.Level</span>
                        }
                    </span>
                    <span class="seat__info">
                        <span class="seat__name">@player.Name</span>
                        @if (player.Badge?.Title is { } seatTitle)
                        {
                            <span class="seat__title">@seatTitle</span>
                        }
                        <span class="seat__stats">
                            <span>@player.CardCount 🂠</span>
                            <span>@player.TotalScore</span>
                            @if (player.HasLaidDown)
                            {
                                <span class="seat__down">bajado</span>
                            }
                        </span>
                    </span>
                </div>
            }
        </div>

        <div class="piles">
            <div class="chatter" aria-live="polite">
                @foreach (var line in Bubbles)
                {
                    <div class="bubble seat--s@(Accent(SeatOf(line.PlayerId))) @(line.PlayerId == View.YouId ? "bubble--mine" : "") @(IsEmote(line.Text) ? "bubble--emote" : "")" @key="line.Seq">
                        <span class="bubble__avatar">@AvatarFor(line.PlayerId, line.Name)</span>
                        <span class="bubble__body">
                            <span class="bubble__name">@(line.PlayerId == View.YouId ? "Tú" : line.Name)</span>
                            <span class="bubble__text">@line.Text</span>
                        </span>
                    </div>
                }

                @if (View.Typing.Count > 0)
                {
                    <div class="typing">
                        <span>@(View.Typing.Count == 1 ? $"{View.Typing[0]} está escribiendo" : "Varios están escribiendo")</span>
                        <span class="typing__dots"><i></i><i></i><i></i></span>
                    </div>
                }
            </div>

            <div class="pile @(CanDraw ? "pile--actionable" : "")">
                <div id="pile-stock"
                     class="pile__stack @(View.StockCount == 0 ? "pile__stack--empty" : "")"
                     role="@(CanDraw ? "button" : null)"
                     tabindex="@(CanDraw ? 0 : null)"
                     aria-label="Robar del mazo"
                     @onclick="@(() => Draw(DrawSource.Stock))">
                    @if (View.StockCount > 0)
                    {
                        <CardView Card="Hidden" FaceDown="true" />
                    }
                    else
                    {
                        <span class="pile__empty">vacío</span>
                    }
                </div>
                <span class="pile__label">Mazo <span class="pile__count">@View.StockCount</span></span>
            </div>

            <div class="pile @(CanDraw && View.DiscardTop is not null ? "pile--actionable" : "")">
                @if (LastTake is { } take)
                {
                    <div class="took seat--s@(Accent(take.Seat))" @key="take.Seq" role="status">
                        <span class="took__avatar">@AvatarFor(take.PlayerId, take.Name)</span>
                        <span class="took__text">
                            <b>@take.Name</b> @(take.Penalty > 0 ? "roba" : "se lleva")
                            <span class="took__card @(take.Card is { IsJoker: false, IsRed: true } ? "took__card--red" : "")">@(take.Card.IsJoker ? "el comodín" : take.Card.Label)</span>
                            @if (take.Penalty > 0)
                            {
                                <span class="took__penalty">+@take.Penalty</span>
                            }
                        </span>
                    </div>
                }
                <div id="pile-discard"
                     class="pile__stack @(View.DiscardTop is null ? "pile__stack--empty" : "")"
                     role="@(CanDraw ? "button" : null)"
                     tabindex="@(CanDraw ? 0 : null)"
                     aria-label="Robar del pozo"
                     @onclick="@(() => Draw(DrawSource.Discard))">
                    @if (View.DiscardTop is { } top)
                    {
                        <CardView Card="top" />
                    }
                    else
                    {
                        <span class="pile__empty">vacío</span>
                    }
                </div>
                <span class="pile__label">Pozo <span class="pile__count">@View.DiscardCount</span></span>
            </div>

            <div id="taken-card" aria-hidden="true">
                @if (TakenCard is { } taken)
                {
                    <CardView Card="taken" />
                }
            </div>
        </div>

        <div class="melds @(Swapping is not null ? "melds--placing" : "")">
            @if (View.Table.Count == 0)
            {
                <div class="melds__empty">Nadie se ha bajado todavía</div>
            }
            else
            {
                @foreach (var meld in View.Table)
                {
                    var mine = meld.OwnerId == View.YouId;
                    var (droppable, swappable, target) = MeldState(meld);
                    var clickable = droppable || swappable || target;

                    <div class="meld meld--s@(Accent(SeatOf(meld.OwnerId))) @(droppable ? "meld--droppable" : "") @(swappable ? "meld--swap" : "") @(target ? "meld--target" : "") @(mine ? "meld--mine" : "")"
                         data-meld-id="@meld.Id"
                         @key="meld.Id"
                         role="@(clickable ? "button" : null)"
                         tabindex="@(clickable ? 0 : null)"
                         @onclick="@(() => MeldClick(meld.Id))">
                        <div class="meld__head">
                            <span class="meld__kind">@(meld.Kind == MeldKind.Trio ? "TRÍO" : "ESCALERA") @meld.Cards.Count</span>
                            @if (swappable && Swapping is null)
                            {
                                <span class="meld__tag">★ canje</span>
                            }
                            <span class="meld__owner">
                                <span class="meld__dot" aria-hidden="true"></span>@(mine ? "Tú" : meld.OwnerName)
                            </span>
                        </div>
                        <div class="meld__cards">
                            @foreach (var card in meld.Cards)
                            {
                                <CardView Card="card" />
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="log">
            @if (View.Log.Count > 0)
            {
                <span class="log__line" @key="View.Log.Count">@View.Log[^1]</span>
            }
        </div>

        <HandFan Cards="DisplayHand" Selected="Selected" OnToggle="ToggleCard" OnClear="DeselectAll" Dealing="Dealing" />

        <div class="actions">
            <button class="btn btn--icon" @onclick="Sort" aria-label="Ordenar la mano"
                    title="@(SortMode == HandSort.BySuit ? "Ordenado por palo" : "Ordenado por número")">
                @(SortMode == HandSort.BySuit ? "♠" : "#")
            </button>

            <button class="btn btn--icon" @onclick="@(() => ShowRules = true)" aria-label="Reglas">?</button>

            <button class="btn btn--icon btn--badged" @onclick="OpenChat" aria-label="Charla de la mesa">
                💬
                @if (Unread > 0)
                {
                    <span class="btn__badge">@(Unread > 9 ? "9+" : Unread.ToString())</span>
                }
            </button>

            <button class="btn btn--icon" @onclick="ToggleMute"
                    aria-label="@(Audio.Muted ? "Activar sonido" : "Silenciar")">
                @(Audio.Muted ? "🔇" : "🔊")
            </button>

            <button class="btn btn--grow @(SelectionIsContract ? "btn--primary" : "")"
                    disabled="@(!CanTryLayDown)" @onclick="LayDown">
                Bajarme
                <span class="btn__hint">@View.ContractCode</span>
            </button>

            <button class="btn btn--grow @(CanDiscard ? "btn--danger" : "")"
                    disabled="@(!CanDiscard)" @onclick="Discard">
                Tirar
            </button>
        </div>

        @if (View.Steal is { YouCanClaim: true } steal)
        {
            <div class="steal" role="alertdialog" aria-label="Puedes robar de contra">
                <span class="steal__title">¡Puedes robar de contra!</span>
                <div class="steal__card">
                    <CardView Card="steal.Card" />
                </div>
                <span class="join-info__hint" style="text-align:center">
                    Te llevas esta carta y @View.Options.StealPenaltyCards más de castigo.
                </span>
                <div class="steal__timer">
                    <div class="steal__timer-fill"
                         style="width:@(steal.SecondsLeft * 100 / Math.Max(1, View.Options.StealWindowSeconds))%"></div>
                </div>
                <div style="display:flex;gap:8px;width:100%">
                    <button class="btn btn--grow" @onclick="@(() => Send(new ClientMessage { Type = MessageType.ClaimSteal }))">
                        Robar (@steal.SecondsLeft s)
                    </button>
                </div>
            </div>
        }

        @if (Swapping is { } swap && Choosing is null)
        {
            <div class="placing" role="status">
                <span class="placing__text">
                    Entregas <strong>@swap.Replacement.Label</strong>. Toca el juego donde va el <strong>comodín</strong>.
                </span>
                <button class="btn btn--sm" @onclick="CancelSwap">Cancelar</button>
            </div>
        }

        @if (Choosing is { } pending)
        {
            <div class="chooser" role="dialog" aria-label="@pending.Title">
                <div class="chooser__title">@pending.Title</div>
                <div class="chooser__actions">
                    @foreach (var choice in pending.Choices)
                    {
                        <button class="btn btn--grow @(choice.Highlight ? "btn--primary" : "")"
                                @onclick="@(() => Resolve(choice))">@choice.Label</button>
                    }
                </div>
                <button class="btn btn--ghost" @onclick="@(() => Choosing = null)">Cancelar</button>
            </div>
        }

        @if (Link == ConnectionState.Reconnecting)
        {
            <div class="relink" role="status">
                <span class="spinner spinner--sm"></span>
                <span>Reconectando con el anfitrión@(Attempt > 1 ? $" (intento {Attempt})" : "")…</span>
            </div>
        }
        else if (Link == ConnectionState.Lost)
        {
            <div class="relink relink--lost" role="alert">
                <span>Se perdió la conexión con el anfitrión.</span>
                <button class="btn btn--sm" @onclick="Leave">Volver al inicio</button>
            </div>
        }

        @if (Error is not null)
        {
            <div class="toast" @onclick="ClearError">@Error</div>
        }
        else if (Hint is not null)
        {
            <div class="toast" @onclick="@(() => Hint = null)">@Hint</div>
        }

        @if (View.Phase == GamePhase.RoundEnd && !ShowScores)
        {
            <RoundOutcome View="View" OnShowScores="@(() => ShowScores = true)"
                          Advance="@(View.YouAreHost ? EventCallback.Factory.Create(this, NextRound) : default)"
                          AdvanceLabel="Siguiente ronda" />
        }
        else if (View.Phase == GamePhase.GameOver && ShowFinale)
        {
            <GameFinale Players="View.Players" YouId="@View.YouId" OnDone="EndFinale" />
        }
        else if (View.Phase == GamePhase.GameOver && !ShowScores)
        {
            <RoundOutcome View="View" IsGameOver="true" Summary="Progress.SummaryFor(View)" OnShowScores="@(() => ShowScores = true)"
                          Advance="@(View.YouAreHost ? EventCallback.Factory.Create(this, PlayAgain) : default)"
                          AdvanceLabel="Jugar otra vez" />
        }

        @if (View.Paused)
        {
            <div class="prompt prompt--pause" role="dialog" aria-modal="true" aria-labelledby="pause-title">
                <div class="prompt__box">
                    <span class="pause-glyph pause-glyph--big" aria-hidden="true"></span>
                    <h2 id="pause-title" class="prompt__title">Partida en pausa</h2>
                    <p class="prompt__text">Los bots esperan a que vuelvas. Ronda @(View.RoundIndex + 1) de @View.TotalRounds · @View.ContractText</p>
                    <div class="prompt__stack">
                        <button class="btn btn--primary" @onclick="ResumeGame">Continuar</button>
                        @if (ConfirmLeave)
                        {
                            <button class="btn btn--danger" @onclick="Leave">Sí, abandonar la partida</button>
                            <button class="btn btn--ghost" @onclick="@(() => ConfirmLeave = false)">Mejor no</button>
                        }
                        else
                        {
                            <button class="btn btn--ghost" @onclick="@(() => ConfirmLeave = true)">Abandonar la partida</button>
                        }
                    </div>
                </div>
            </div>
        }

        @if (ShowChat)
        {
            <div class="chat" role="dialog" aria-label="Charla de la mesa">
                <div class="chat__head">
                    <div class="chat__title">Charla <span>@View.Players.Count en la mesa</span></div>
                    <button class="btn btn--ghost btn--icon" @onclick="@(() => ShowChat = false)" aria-label="Cerrar">✕</button>
                </div>

                <div class="chat__list">
                    @if (View.Chat.Count == 0)
                    {
                        <div class="chat__empty">
                            Aquí se pica, se celebra y se protesta. Di algo, que los demás también hablan.
                        </div>
                    }

                    @foreach (var line in View.Chat.AsEnumerable().Reverse())
                    {
                        var mine = line.PlayerId == View.YouId;

                        <div class="msg seat--s@(Accent(SeatOf(line.PlayerId))) @(mine ? "msg--mine" : "") @(IsEmote(line.Text) ? "msg--emote" : "")" @key="line.Seq">
                            @if (!mine)
                            {
                                <span class="msg__avatar">@AvatarFor(line.PlayerId, line.Name)</span>
                            }
                            <span class="msg__body">
                                @if (!mine)
                                {
                                    <span class="msg__name">@line.Name</span>
                                }
                                <span class="msg__text">@line.Text</span>
                            </span>
                        </div>
                    }
                </div>

                <div class="chat__quick">
                    @foreach (var quick in Progress.QuickPhrases)
                    {
                        <button class="chip" @onclick="@(() => SendChat(quick))">@quick</button>
                    }
                </div>

                <div class="chat__form">
                    <input class="chat__input" maxlength="160" placeholder="Escribe algo a la mesa…"
                           @bind="Draft" @bind:event="oninput" @onkeydown="OnChatKey" />
                    <button class="btn btn--primary chat__send" disabled="@(string.IsNullOrWhiteSpace(Draft))"
                            @onclick="@(() => SendChat(Draft))">Enviar</button>
                </div>
            </div>
        }
    </div>
}

<Celebrations Paused="@(ShowIntro || ShowFinale || View?.Paused == true)" />

@if (View is not null && ShowRules)
{
    <RulesSheet Options="View.Options" OnClose="@(() => ShowRules = false)" />
}

@if (View is not null && ShowScores)
{
    <ScoreSheet Players="View.Players" Title="@ScoresTitle" OnClose="@(() => ShowScores = false)">
        <Footer>
            @if (View.Phase is GamePhase.RoundEnd or GamePhase.GameOver)
            {
                @if (View.YouAreHost)
                {
                    <button class="btn btn--primary" style="width:100%;margin-bottom:8px"
                            @onclick="@(View.Phase == GamePhase.GameOver ? PlayAgain : NextRound)">
                        @(View.Phase == GamePhase.GameOver ? "Jugar otra vez" : "Siguiente ronda")
                    </button>
                }
                @if (View.Phase == GamePhase.GameOver)
                {
                    <button class="btn" style="width:100%" @onclick="Leave">Salir de la sala</button>
                }
            }
        </Footer>
    </ScoreSheet>
}

@code {
    private HashSet<int> Selected = [];
    private readonly List<int> PickOrder = [];
    private HandSort SortMode = HandSort.BySuit;
    private bool ShowRules;
    private bool ShowScores;
    private bool ShowChat;
    private bool Dealing;
    private int LastRound = -1;
    private int LastHandCount = -1;

    private int LastSonifiedRound = -1;
    private int LastTableCount = -1;
    private int LastDiscardCount = -1;
    private int LastStealSecond = -1;
    private bool WasMyTurn;
    private GamePhase LastPhase = GamePhase.Lobby;
    private int SentBadgeVersion = -1;
    private bool SawLobby;
    private bool ShowIntro;
    private bool ShowFinale;
    private bool ConfirmLeave;
    private int? RoundCard;
    private string? LastErrorHeard;

    private HashSet<int>? PrevHandIds;
    private int PrevDiscardCount = -1;
    private Dictionary<int, string>? PrevMeldCards;
    private Dictionary<string, int>? PrevMeldSizes;
    private readonly List<Flight> Pending = [];
    private readonly List<SeatFlight> PendingSeats = [];
    private Dictionary<string, int>? PrevCardCounts;
    private int PrevStockCount = -1;
    private Card? PrevDiscardTop;
    private int PrevRoundSeen = -1;
    private Card? TakenCard;
    private Take? LastTake;
    private int TakeSeq;

    private sealed record Take(int Seq, string PlayerId, string Name, int Seat, Card Card, int Penalty);
    private double[]? DiscardOrigin;
    private readonly Dictionary<int, double[]> LayOrigins = [];

    private string Draft = "";
    private int LastSeenSeq;
    private int LastHeardSeq;
    private readonly Dictionary<int, DateTime> BubbleShownAt = [];
    private static readonly TimeSpan BubbleLife = TimeSpan.FromSeconds(7.4);

    private static readonly Card Hidden = new(-1, Suit.Spades, Rank.Two);

    private IGameClient? Client => App.Client;

    private PlayerView? View => Client?.View;

    private string? Error => Client?.LastError;

    private ConnectionState Link => Client?.Connection ?? ConnectionState.Connected;

    private int Attempt => Client?.ReconnectAttempt ?? 0;

    private bool CanDraw => View is { YourTurn: true, Phase: GamePhase.Draw };

    private bool CanAct => View is { YourTurn: true, Phase: GamePhase.Action };

    private bool CanDiscard => CanAct && Selected.Count == 1 && Swapping is null;

    private string? Hint;

    private bool SelectionIsContract;

    private bool CanTryLayDown => CanAct
                                  && !(Me?.HasLaidDown ?? false)
                                  && Selected.Count > 0;

    private bool CanExtend => CanAct
                              && Selected.Count == 1
                              && (Me?.HasLaidDown ?? false);

    private PlayerSummary? Me => View?.Players.FirstOrDefault(p => p.Id == View.YouId);

    private int Unread => View is null ? 0 : View.Chat.Count(l => l.Seq > LastSeenSeq && l.PlayerId != View.YouId);

    private IEnumerable<ChatLine> Bubbles
    {
        get
        {
            if (View is null || ShowChat)
                yield break;

            var now = DateTime.UtcNow;

            foreach (var line in View.Chat.TakeLast(3))
            {
                if (BubbleShownAt.TryGetValue(line.Seq, out var shown) && now - shown < BubbleLife)
                    yield return line;
            }
        }
    }

